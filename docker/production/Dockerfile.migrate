# syntax=docker/dockerfile:1.7

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .

RUN dotnet restore LocationSearch.slnx

ENV PATH="${PATH}:/root/.dotnet/tools"
RUN dotnet tool install --global dotnet-ef

RUN for entry in "Sandbox:SandboxDbContext" \
              "Users:UsersDbContext" \
              "Reviews:ReviewsDbContext" \
              "AgentCore:AgentCoreDbContext"; do \
      module="${entry%%:*}"; \
      context="${entry##*:}"; \
      echo "Building bundle for $module ($context)"; \
      dotnet ef migrations bundle \
        --project src/Modules/$module \
        --startup-project src/LocationSearch.Api \
        --context $context \
        --output /out/efbundle-$module \
        --self-contained \
        --target-runtime linux-x64; \
    done

FROM mcr.microsoft.com/mssql-tools18:latest
WORKDIR /migrations

COPY --from=build /out/efbundle-* /migrations/
COPY docker/production/scripts/run-migrations.sh /migrations/run-migrations.sh

RUN chmod +x /migrations/efbundle-*

ENTRYPOINT ["/migrations/run-migrations.sh"]
